@_Initialize(argc : int32, argv : Array[string]) >> int32:
    Println! << ToString << Bhaskara << 5, -6, 1
    return 0

@Bhaskara(A : int32, B : int32, C : int32) >> &Vec2:
    var Delta = #((B ^ 2) - (4 * A * C))
    
    if Delta < 0:
        return NULL
    
    elif Delta == 0:
        return ((~B) + Delta) / (2 * A)

    var Root1 := ((~B) + Delta) / (2 * A)
    var Root2 := ((~B) - Delta) / (2 * A)

    var ResultVec : Vec2 = {Root1, Root2}
    
    return &ResultVec